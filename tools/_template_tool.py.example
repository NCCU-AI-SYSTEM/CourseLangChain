    required_param: str,
    optional_param: int = 0,
) -> str:
    """當用戶想 [做某件事] 時呼叫此工具。

    Args:
        required_param: 描述,要寫得讓 LLM 看得懂何時填什麼
        optional_param: 描述

    Returns:
        人類可讀的結果字串。失敗時以 "ERROR: ..." 開頭。
    """
    try:
        # TODO: 你的邏輯
        result = f"處理 {required_param}, optional={optional_param}"
        return result
    except Exception as e:
        return f"ERROR: {e}"


