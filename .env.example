# LLM (host, GPU)
OLLAMA_HOST="http://localhost:11434"
MODEL="llama3.1:8b"
GOOGLE_API_KEY=
USE_GOOGLE_AI=false

# Database toggle
USE_SQLITE=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/academic"

# Semester scoping (must match your academic.sql)
COURSE_YEAR=114
COURSE_SEMESTER=2

# HuggingFace (for embedding model download in Docker)
HF_TOKEN=

# Tracing
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="http://localhost:3000"
