# 這個檔放「這台機器的設定」:服務位置、金鑰、硬體。每個人不一樣,不進 git。
#
# 「資料本身的屬性」(embedding 模型、維度、學期、schema 版本)在 contract.yaml,
# 那些**不能**用環境變數覆寫 —— 一個設定只該有一個來源。要改學期或模型請改
# contract.yaml(兩個 repo 一起改),重跑 course-data-prep 產新的成品。
#
# 優先順序:
#   host 上跑(uv)  → 這個檔說了算(load_dotenv(override=True),shell 變數蓋不過)
#   容器裡跑(docker)→ .env 根本不會進到容器(.dockerignore),改由
#                      docker-compose.yml 的 environment: 逐項宣告
# 所以在容器裡要調參數,請改 docker-compose.yml,不是這個檔。
# 反過來說:app 會讀的每個變數,compose 都必須列出來,否則容器裡會靜靜地用程式預設值。

# LLM(跑在 host 上,用得到 GPU)
OLLAMA_HOST="http://localhost:11434"
MODEL="llama3.1:8b"
GOOGLE_API_KEY=
USE_GOOGLE_AI=false

# LLM 供應者:ollama / google / openai。留空 = 照 USE_GOOGLE_AI 決定(舊行為)。
# openai = 任何 OpenAI 相容端點(LiteLLM proxy、vLLM、llama.cpp server、OpenAI 本身)
# LLM_PROVIDER=openai
# OPENAI_BASE_URL="http://localhost:4000/v1"
# OPENAI_API_KEY=
# OPENAI_MODEL="qwen3.8:27b-q4_K_M"

# 資料源
#   false = PostgreSQL(預設;先 docker compose up -d postgres)
#   true  = SQLite + faiss_index/ 【已棄用,預計移除】
USE_SQLITE=false
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/academic"
# docker compose 的 postgres 對外 port(預設 5432)。被別的專案佔用時改這個,
# 上面 DATABASE_URL 的 port 也要一起改。
# POSTGRES_PORT=5433

# 查詢時把 query 轉向量的裝置。只 embed 一句話,cpu 就夠;要 GPU 可設 cuda / mps。
EMBED_DEVICE=cpu

# 混合檢索的 RRF 參數(純檢索調校,與資料無關,所以不在 contract.yaml)
# RRF_K=60
# RRF_CANDIDATES=50

# agent 的安全上限。預設 600 秒是照本機模型抓的,雲端模型可以調小很多。
# AGENT_TIMEOUT_SEC=600
# AGENT_MAX_STEPS=8

# 外部 MCP 工具:另一組的校內網站檢索服務(streamable HTTP 端點)。留空 = 不啟用。
# 本機測試可先跑假 server:uv run python -m mcp_servers.campus_web_stub
# CAMPUS_WEB_MCP_URL="http://localhost:8765/mcp"

# 外部 MCP 工具:使用者本人的 NCCU Moodle(nccu-moodle-mcp,streamable HTTP 端點)。留空 = 不啟用。
# 帳密不放這裡 —— 每位使用者在網頁上自己登入,只存在後端記憶體。
# 真的 server:cd nccu-moodle-mcp && uv run nccu-moodle-mcp http
# 假 server(密碼一律 demo,不會鎖到真帳號):uv run python -m mcp_servers.moodle_stub
# MOODLE_MCP_URL="http://localhost:3033/mcp"

# Tracing
# 留空 = 追蹤關閉(只會在 log 印一行提示,不會報錯,很容易誤以為有在收)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL="http://localhost:3000"

# 用 docker compose --profile app 跑 app 時才會用到。
# 上面的 OLLAMA_HOST / LANGFUSE_BASE_URL 是給 host 上跑 uv 用的(localhost),
# 帶進容器就是連容器自己,一定連不到 —— 所以容器改吃這一組。
# DOCKER_OLLAMA_HOST="http://host.docker.internal:11434"
# DOCKER_OPENAI_BASE_URL="http://host.docker.internal:4000/v1"
# DOCKER_LANGFUSE_BASE_URL="http://host.docker.internal:3000"
# DOCKER_CAMPUS_WEB_MCP_URL="http://host.docker.internal:8765/mcp"   # server 要用 --host 0.0.0.0 起,容器才連得到
# DOCKER_MOODLE_MCP_URL="http://host.docker.internal:3033/mcp"       # 真的 server 要設 MCP_HOST=0.0.0.0
